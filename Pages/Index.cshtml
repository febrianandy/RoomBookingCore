@page
@model RoomBookingCore.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard Utama";
}

<div class="container-fluid px-4">
    <h2 class="mt-4 fw-bold text-dark">Konsep Tata Letak Halaman Utama</h2>
    <p class="text-muted">Monitoring sistem peminjaman ruangan secara real-time.</p>
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Booking (Nuansa Biru) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm text-white rounded-4" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small text-uppercase fw-semibold opacity-75">Total Booking</span>
                        <h3 class="fw-bold mt-2 mb-0">@Model.TotalBookingCount</h3>
                    </div>
                    <div class="fs-1 opacity-25">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Jam Pemakaian (Nuansa Ungu / Indigo) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm text-white rounded-4" style="background: linear-gradient(135deg, #6f42c1 0%, #59359a 100%);">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small text-uppercase fw-semibold opacity-75">Jam Pemakaian</span>
                        <h3 class="fw-bold mt-2 mb-0">@Model.TotalHoursUsed <span class="fs-6 fw-normal">Jam</span></h3>
                    </div>
                    <div class="fs-1 opacity-25">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Ruangan Favorit (Nuansa Hijau / Teal) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm text-white rounded-4" style="background: linear-gradient(135deg, #198754 0%, #146c43 100%);">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div class="overflow-hidden">
                        <span class="small text-uppercase fw-semibold opacity-75">Ruangan Favorit</span>
                        <h5 class="fw-bold mt-2 mb-0 text-truncate">@Model.FavoriteRoom</h5>
                    </div>
                    <div class="fs-1 opacity-25 ms-2">
                        <i class="fa-solid fa-door-open"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Dept Teraktif (Nuansa Jingga / Orange) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm text-white rounded-4" style="background: linear-gradient(135deg, #fd7e14 0%, #e8590c 100%);">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div class="overflow-hidden">
                        <span class="small text-uppercase fw-semibold opacity-75">Dept Teraktif</span>
                        <h5 class="fw-bold mt-2 mb-0 text-truncate">@Model.ActiveDepartment</h5>
                    </div>
                    <div class="fs-1 opacity-25 ms-2">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. BAGIAN BAWAH: GRAFIK & STATUS RUANGAN -->
    <div class="row g-4">
        <!-- SISI KIRI: Grafik Pemakaian per Departemen -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold text-dark">Grafik Pemakaian per Departemen (Bar Chart)</h6>
                </div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <div style="height: 300px;">
                        <canvas id="deptChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-dark">Status Ruangan Hari Ini (In Use vs Available)</h6>
            </div>
            <div class="card-body" id="roomStatusContainer">
                <!-- KELOMPOK IN USE -->
                <div class="text-danger fw-bold small mb-2">IN USE</div>
                @if (Model.InUseRooms.Any())
                {
                    @foreach (var room in Model.InUseRooms)
                    {
                        <div class="d-flex justify-content-between align-items-center p-2 mb-2 bg-light rounded border-start border-danger border-4">
                            <span class="fw-semibold text-dark">@room.RoomName - @room.TimeSlot</span>
                            <span class="badge bg-danger rounded-circle p-2"></span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small italic">Tidak ada ruangan yang sedang digunakan saat ini.</p>
                }

                <hr class="my-3">

                <!-- KELOMPOK AVAILABLE -->
                <div class="text-success fw-bold small mb-2">AVAILABLE</div>
                @if (Model.AvailableRooms.Any())
                {
                    @foreach (var room in Model.AvailableRooms)
                    {
                        <div class="d-flex justify-content-between align-items-center p-2 mb-2 bg-light rounded border-start border-success border-4">
                            <span class="fw-semibold text-dark">@room.RoomName</span>
                            <span class="badge bg-success rounded-circle p-2"></span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small italic">Semua ruangan sedang terpakai.</p>
                }
            </div>
        </div>
    </div>
    </div>
</div>

<!-- SCRIPTS UNTUK CHART.JS -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('deptChart').getContext('2d');
        const deptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptBookingStats.Keys));
        const deptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptBookingStats.Values));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: deptLabels,
                datasets: [{
                    label: 'Jumlah Peminjaman',
                    data: deptData,
                    backgroundColor: '#0d6efd',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

        function refreshRoomStatus() {
            fetch('?handler=RoomStatus')
                .then(response => response.json())
                .then(data => {
                    let container = document.getElementById('roomStatusContainer');
                    let html = '';

                    // 1. Render IN USE
                    html += '<div class="text-danger fw-bold small mb-2">IN USE</div>';
                    if (data.inUse.length > 0) {
                        data.inUse.forEach(room => {
                            html += `<div class="d-flex justify-content-between align-items-center p-2 mb-2 bg-light rounded border-start border-danger border-4">
                                        <span class="fw-semibold text-dark">${room.roomName} - ${room.timeSlot}</span>
                                        <span class="badge bg-danger rounded-circle p-2"></span>
                                     </div>`;
                        });
                    } else {
                        html += '<p class="text-muted small italic">Tidak ada ruangan yang sedang digunakan saat ini.</p>';
                    }

                    html += '<hr class="my-3">';

                    // 2. Render AVAILABLE
                    html += '<div class="text-success fw-bold small mb-2">AVAILABLE</div>';
                    if (data.available.length > 0) {
                        data.available.forEach(room => {
                            html += `<div class="d-flex justify-content-between align-items-center p-2 mb-2 bg-light rounded border-start border-success border-4">
                                        <span class="fw-semibold text-dark">${room.roomName}</span>
                                        <span class="badge bg-success rounded-circle p-2"></span>
                                     </div>`;
                        });
                    } else {
                        html += '<p class="text-muted small italic">Semua ruangan sedang terpakai.</p>';
                    }

                    // Masukkan ke dalam container
                    container.innerHTML = html;
                })
                .catch(error => console.error('Gagal mengambil status ruangan:', error));
        }

        // Jalankan fungsi setiap 5 detik (5000 ms)
        setInterval(refreshRoomStatus, 5000);
    </script>
}