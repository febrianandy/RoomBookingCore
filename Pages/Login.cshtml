@page
@model RoomBookingCore.Pages.LoginModel
@{
    Layout = null; 
    ViewData["Title"] = "Login Room Booking";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow-sm p-4" style="width: 100%; max-width: 400px;">
        <div class="card-body">
            <div class="text-center mb-4">
                <h3 class="fw-bold">Room Booking</h3>
                <p class="text-muted">Silakan masukkan email Anda untuk masuk</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Model.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label for="Email" class="form-label">Email Kantor / Sistem</label>
                    <input type="email" class="form-control" id="Email" name="Email" placeholder="contoh: admin@roombooking.com" required autofocus />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">Masuk</button>
            </form>

            <hr class="my-4">
            
            <div class="text-center text-muted small">
                <p class="mb-1">Uji coba cepat:</p>
                <code>superuser@roombooking.com</code><br>
                <code>admin@roombooking.com</code><br>
                <code>pegawai@roombooking.com</code>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>