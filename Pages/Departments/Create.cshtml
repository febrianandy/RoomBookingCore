@page
@model RoomBookingCore.Pages.Departments.CreateModel

@{
    ViewData["Title"] = "Tambah Departemen";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <h3 class="fw-bold text-dark mb-1">Tambah Departemen Baru</h3>
            <p class="text-muted small mb-4">Masukkan nama departemen atau divisi perusahaan.</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Department.DepartmentName" class="form-label fw-semibold"></label>
                    <input asp-for="Department.DepartmentName" class="form-control" placeholder="Contoh: IT, HRD, Finance" />
                    <span asp-validation-for="Department.DepartmentName" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-page="Index" class="btn btn-secondary">Kembali</a>
                    <button type="submit" class="btn btn-primary">Simpan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}