@page
@model RoomBookingCore.Pages.Departments.DeleteModel

@{
    ViewData["Title"] = "Hapus Departemen";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-3 border-danger">
        <div class="card-body p-4">
            <h3 class="fw-bold text-danger mb-1">Konfirmasi Hapus</h3>
            <p class="text-muted small mb-4">Apakah Anda yakin ingin menghapus departemen ini?</p>

            <div class="p-3 bg-light rounded mb-4">
                <span class="text-muted small d-block">Nama Departemen:</span>
                <strong class="text-dark fs-5">@Model.Department.DepartmentName</strong>
            </div>

            <form method="post">
                <input type="hidden" asp-for="Department.DepartmentId" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="Index" class="btn btn-secondary">Batal</a>
                    <button type="submit" class="btn btn-danger">Ya, Hapus</button>
                </div>
            </form>
        </div>
    </div>
</div>