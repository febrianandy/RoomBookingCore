@page
@model RoomBookingCore.Pages.Departments.IndexModel

@{
    ViewData["Title"] = "Master Departemen";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Manajemen Departemen</h2>
            <p class="text-muted small mb-0">Kelola daftar departemen/divisi yang ada di perusahaan.</p>
        </div>
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Tambah Departemen Baru
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">No</th>
                            <th>Nama Departemen</th>
                            <th class="text-end pe-4">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Departments.Any())
                        {
                            int no = 1;
                            foreach (var item in Model.Departments)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted">@(no++)</td>
                                    <td>
                                        <span class="fw-bold text-dark">@item.DepartmentName</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <!-- Menggunakan DepartmentId -->
                                        <a asp-page="./Edit" asp-route-id="@item.DepartmentId" class="btn btn-sm btn-outline-warning me-1">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@item.DepartmentId" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i> Hapus
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted fst-italic">Belum ada data departemen.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>